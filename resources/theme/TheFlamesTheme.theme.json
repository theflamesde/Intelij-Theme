{
  "name": "The Flames Islands",
  "dark": true,
  "author": "The Flames",

  "parentTheme": "Islands Dark",
  "editorScheme": "/theme/TheFlamesTheme.theme.xml",

  "colors": {
    "accentColor": "#ff4040",

    "backgroundColor": "#11161c",
    "editorBackground": "#1b2330",
    "toolWindowBackground": "#161d26",

    "borderColor": "#2a313c",

    "foregroundColor": "#e6edf3",
    "infoForeground": "#cdd9e5",

    "notificationBackground": "#202938",

    "selectionBackground": "#3a2020",
    "selectionForeground": "#f0f6fc",

    "activeTabBackground": "#1a212b"
  },

  "ui": {

    "ColorPalette": {
      "Component.focusColor": "#ff4040"
    },

    "*": {
      "background": "backgroundColor",
      "foreground": "#e6edf3",

      "selectionBackground": "#3a2020",
      "selectionForeground": "#f0f6fc",

      "selectionInactiveBackground": "#262d36",

      "borderColor": "#2a313c",

      "focusColor": "#ff4040",
      "focusedBorderColor": "#ff4040",

      "separatorColor": "#2f3742"
    },

    "TabbedPane": {
      "underlineColor": "#ff4040",
      "focusColor": "#ff4040",
      "hoverColor": "#2b1b1b",
      "contentAreaColor": "#141b22",
      "tabHeight": 36
    },

    "EditorTabs": {
      "underlinedTabBackground": "#1a2230",
      "inactiveUnderlinedTabBackground": "#141b22",
      "underlinedBorderColor": "#ff4040",
      "inactiveUnderlinedTabBorderColor": "#2a3442"
    },

    "MainWindow.background": "#11161c",
    "MainToolbar.background": "#11161c",

    "Panel.background": "#161d26",
    "SidePanel.background": "#161d26",

    "Editor": {
      "background": "#1b2330",
      "foreground": "#e6edf3",

      "SearchField": {
        "background": "#202938"
      }
    },

    "MainWindow.Tab": {
      "background": "#11161c",
      "hoverBackground": "#1a212b",

      "foreground": "#7d8590",
      "selectedForeground": "#e6edf3",

      "selectedBackground": "#1a212b"
    },

    "DefaultTabs": {
      "underlineColor": "#ff4040",
      "inactiveUnderlineColor": "#ff4040"
    },

    "Button": {
      "foreground": "#f0f6fc",

      "startBackground": "#202938",
      "endBackground": "#202938",

      "startBorderColor": "#2f3742",
      "endBorderColor": "#2f3742",

      "default": {
        "foreground": "#ffffff",
        "startBackground": "#ff4040",
        "endBackground": "#ff4040",
        "startBorderColor": "#ff4040",
        "endBorderColor": "#ff4040"
      }
    },

    "ActionButton": {
      "hoverBackground": "#202938",
      "pressedBackground": "#ff4040"
    },

    "Popup": {
      "background": "#202938",
      "borderColor": "#2f3742"
    },

    "List": {
      "selectionBackground": "#3a2020",
      "selectionForeground": "#ffffff"
    },

    "Tree": {
      "selectionBackground": "#3a2020",
      "modifiedItemForeground": "#ff4040"
    },

    "ProgressBar": {
      "trackColor": "#161d26",
      "progressColor": "#ff4040"
    },

    "Link": {
      "activeForeground": "#ff4040",
      "hoverForeground": "#ff4040",
      "pressedForeground": "#ff4040",
      "visitedForeground": "#ff4040"
    },

    "ToolTip": {
      "background": "#202938"
    }
  }
}