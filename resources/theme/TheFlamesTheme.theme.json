{
  "name": "The Flames Dark",
  "dark": true,
  "author": "The Flames",

  "parentTheme": "Islands Dark",
  "editorScheme": "/theme/TheFlamesTheme.theme.xml",

  "colors": {
    "accentColor": "#ff4040",

    "backgroundColor": "#191A1C",
    "editorBackground": "#191A1C",
    "toolWindowBackground": "#26282C",

    "borderColor": "#33353B",

    "foregroundColor": "#D1D3D9",
    "infoForeground": "#9FA2A8",

    "notificationBackground": "#33353B",

    "selectionBackground": "#3a2020",
    "selectionForeground": "#FFFFFF",

    "activeTabBackground": "#33353B",
    
    "contrastBorderColor": "#40434A",
    "disabledBorderColor": "#26282C",
    
    "textDefaultColor": "#D1D3D9",
    "textMutedColor": "#9FA2A8",
    "textSecondaryColor": "#73767C",
    "textDisabledColor": "#4C4F56",
    "textLinkColor": "#ff4040",
    
    "editorCaretColor": "#CED0D6",
    "editorLineNumberColor": "#4B5059",
    "editorIndentGuideColor": "#323438",
    
    "successColor": "#338555",
    "errorColor": "#C54E58",
    "warningColor": "#A56906",
    "infoColor": "#ff4040"
  },

  "ui": {

    "ColorPalette": {
      "Component.focusColor": "#ff4040"
    },

    "*": {
      "background": "backgroundColor",
      "foreground": "#D1D3D9",

      "selectionBackground": "#3a2020",
      "selectionForeground": "#FFFFFF",

      "selectionInactiveBackground": "#26282C",

      "borderColor": "#33353B",

      "focusColor": "#ff4040",
      "focusedBorderColor": "#ff4040",

      "separatorColor": "#26282C"
    },

    "TabbedPane": {
      "underlineColor": "#ff4040",
      "focusColor": "#ff4040",
      "hoverColor": "activeTabBackground",
      "contentAreaColor": "activeTabBackground",
      "tabHeight": 36
    },

    "EditorTabs": {
      "underlinedTabBackground": "activeTabBackground",
      "inactiveUnderlinedTabBackground": "backgroundColor",
      "underlinedBorderColor": "#ff4040",
      "inactiveUnderlinedTabBorderColor": "#33353B"
    },

    "MainWindow.background": "#191A1C",
    "MainToolbar.background": "#191A1C",

    "Panel.background": "#26282C",
    "SidePanel.background": "#26282C",

    "Editor": {
      "background": "#191A1C",
      "foreground": "#D1D3D9",

      "SearchField": {
        "background": "#212326",
        "borderColor": "#26282C"
      }
    },

    "MainWindow.Tab": {
      "borderColor": "backgroundColor",
      "background": "#191A1C",
      "hoverBackground": "activeTabBackground",

      "foreground": "#73767C",
      "selectedForeground": "foregroundColor",

      "selectedBackground": "activeTabBackground",
      "selectedInactiveBackground": "activeTabBackground"
    },

    "DefaultTabs": {
      "underlineColor": "#ff4040",
      "inactiveUnderlineColor": "#26282C"
    },

    "Button": {
      "foreground": "#D1D3D9",

      "startBackground": "#26282C",
      "endBackground": "#26282C",

      "startBorderColor": "#33353B",
      "endBorderColor": "#33353B",

      "default": {
        "foreground": "#FFFFFF",
        "startBackground": "#ff4040",
        "endBackground": "#ff4040",
        "startBorderColor": "#ff4040",
        "endBorderColor": "#ff4040"
      }
    },

    "ActionButton": {
      "hoverBackground": "#26282C",
      "pressedBackground": "#3a2020"
    },

    "Popup": {
      "background": "#26282C",
      "borderColor": "#33353B"
    },

    "List": {
      "selectionBackground": "#3a2020",
      "selectionForeground": "#FFFFFF"
    },

    "Tree": {
      "selectionBackground": "#3a2020",
      "modifiedItemForeground": "#ff4040"
    },

    "ProgressBar": {
      "trackColor": "#26282C",
      "progressColor": "#ff4040"
    },

    "Link": {
      "activeForeground": "#ff4040",
      "hoverForeground": "#ff4040",
      "pressedForeground": "#ff4040",
      "visitedForeground": "#ff4040"
    },

    "ToolTip": {
      "background": "#26282C",
      "foreground": "#D1D3D9",
      "borderColor": "#33353B"
    },

    "ToolWindow": {
      "background": "toolWindowBackground",
      "Button": {
        "hoverBackground": "activeTabBackground",
        "selectedBackground": "activeTabBackground",
        "selectedForeground": "foregroundColor"
      },

      "Header": {
        "background": "activeTabBackground",
        "inactiveBackground": "toolWindowBackground"
      },

      "HeaderTab": {
        "hoverBackground": "activeTabBackground",
        "hoverInactiveBackground": "activeTabBackground",
        "selectedInactiveBackground": "activeTabBackground"
      }
    }
  },
  "StatusBar": {
    "background": "#191A1C",
    "foreground": "#73767C"
  },

  "Header": {
    "background": "#191A1C"
  },
  "ScrollBar": {
    "thumbColor": "#40434A",
    "thumbBorderColor": "#33353B",
    "hoverColor": "#4C4F56",
    "trackColor": "#26282C",
    "width": 12
  },
  "Notifications": {
    "errorBackground": "#4B2C2C",
    "errorBorderColor": "#C54E58",
    "warningBackground": "#3D3410",
    "warningBorderColor": "#A56906",
    "infoBackground": "#3a2020",
    "infoBorderColor": "#ff4040"
  },
  "Component": {
    "disabledForeground": "#4C4F56",
    "disabledBackground": "#191A1C"
  },
  "Hyperlink": {
    "foreground": "#ff4040",
    "activeForeground": "#ff4040",
    "hoverForeground": "#ff4040"
  },
  "ActionLink": {
    "foreground": "#ff4040",
    "hoverForeground": "#ff4040",
    "pressedForeground": "#ff4040"
  },
  "WelcomeScreen": {
    "foreground": "#73767C",
    "headerForeground": "#D1D3D9",
    "linkForeground": "#ff4040",

    "Projects": {
      "selectionBackground": "activeTabBackground",
      "selectionInactiveBackground": "activeTabBackground",
      "selectionForeground": "#FFFFFF"
    }
  },

  "WelcomeScreen.ProjectItem": {
    "foreground": "#D1D3D9",
    "hoverBackground": "#26282C"
  },
  "Editor.EmptyText": {
    "foreground": "#73767C"
  },
  "TextField": {
    "foreground": "#D1D3D9",
    "caretForeground": "#CED0D6",
    "background": "#212326",
    "borderColor": "#26282C"
  },
  "Editor.caretColor": "#CED0D6",
  "Editor.inactiveCaretColor": "#73767C"
}
